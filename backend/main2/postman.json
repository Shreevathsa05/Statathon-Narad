        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "Surveys",
      "item": [
        {
          "name": "Create Survey",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"surveyId\": \"SURV-001\",\n  \"name\": \"Community Health Survey\",\n  \"status\": \"draft\",\n  \"supportedLanguages\": [\"en\", \"hi\"],\n  \"questionSections\": [\n    {\n      \"sectionId\": \"sec-1\",\n      \"title\": {\n        \"en\": \"General\"\n      },\n      \"questions\": [\n        {\n          \"qid\": \"q1\",\n          \"type\": \"text\",\n          \"text\": {\n            \"en\": \"What is your name?\"\n          }\n        },\n        {\n          \"qid\": \"q2\",\n          \"type\": \"mcq\",\n          \"text\": {\n            \"en\": \"Select one option\"\n          },\n          \"options\": [\n            {\n              \"id\": \"1\",\n              \"label\": {\n                \"en\": \"Option 1\"\n              }\n            },\n            {\n              \"id\": \"2\",\n              \"label\": {\n                \"en\": \"Option 2\"\n              }\n            }\n          ]\n        }\n      ]\n    }\n  ],\n  \"categories\": [\"general\"],\n  \"createdBy\": \"{{userId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/survey"
          }
        },
        {
          "name": "Get All Surveys",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/survey"
          }
        },
        {
          "name": "Get Survey By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/survey/{{surveyId}}"
          }
        },
        {
          "name": "Update Survey",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\",\n  \"allowedChannels\": [\"avatar\", \"sms\"]\n}"
            },
            "url": "{{baseUrl}}/api/survey/{{surveyId}}"
          }
        },
        {
          "name": "Delete Survey",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/survey/{{surveyId}}"
          }
        }
      ]
    },
    {
      "name": "Responses",
      "item": [
        {
          "name": "Submit Survey Response",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "response",
                  "type": "text",
                  "value": "[{\"qid\":\"q1\",\"answer\":\"John Doe\"}]"
                },
                {
                  "key": "paraInfo",
                  "type": "text",
                  "value": "{\"interviewInfo\":{\"interviewMode\":\"online\",\"interviewStartTime\":\"2026-06-11T10:00:00.000Z\"}}"
                }
              ]
            },
            "url": "{{baseUrl}}/api/response/{{surveyId}}"
          }
        },
        {
          "name": "Get All Responses By Survey",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/response/{{surveyId}}"
          }
        },
        {
          "name": "Get Flagged Responses By Survey",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/response/{{surveyId}}/flagged"
          }
        }
      ]
    },
