                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"aadhaarNo\": \"123456789012\",\n  \"phone\": \"9876543210\",\n  \"fullName\": \"John Doe\",\n  \"age\": 32,\n  \"gender\": \"male\",\n  \"primaryLanguage\": \"hindi\",\n  \"pincode\": \"110001\",\n  \"area\": \"north delhi\"\n}"
            },
            "url": "{{baseUrl}}/api/demographic"
          }
