            "body": {
              "mode": "raw",
              "raw": "{\n  \"filters\": {\n    \"age\": {\"$gte\": 18},\n    \"gender\": \"male\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/campaign/generate/{{surveyId}}"
          }
        },
        {
          "name": "Make Survey General Access",
          "request": {
            "method": "POST",
            "header": [],
