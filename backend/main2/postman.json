              "raw": "{\n  \"targetRoles\": [\"admin\", \"fod\"],\n  \"title\": \"Survey Updated\",\n  \"message\": \"Survey status changed to approved\",\n  \"type\": \"SURVEY_STATUS_UPDATE\",\n  \"metadata\": {\n    \"surveyId\": \"SURV-001\"\n  }\n}"
