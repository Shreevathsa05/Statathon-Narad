PORT=5001
MONGODB_URI=mongodb://localhost:27017
DB_NAME=statathon

# WhatsApp Cloud API credentials
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token

# Telephony credentials for OTP dispatch (optional if using direct Twilio, or fallback)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Pincode Geo-Enrichment API URL
PINCODE_API_URL=http://localhost:3000/api/demographic/pincode_lookup
EXOTEL_API_URL=http://localhost:4000/api/auth
